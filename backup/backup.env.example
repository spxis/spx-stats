# Copy to backup.env on nas2 (next to docker-compose.yml), mode 600, and fill in the empty values. Never commit the real file.
# Names only here. The install command in backup/README.md writes this file for you from the Mac keychain without printing a value.

# DS1: nas2 reaches it over the home LAN (the nas1 address from the private host mapping)
PGHOST=
PGPORT=55440
PGUSER=spx_backup
PGDATABASE=spx_stats
# the password of the read-only role spx_backup (Mac keychain item 'spx-stats spx_backup DS1 55440')
PGPASSWORD=

# run-log heartbeat and admin alert (scripts/runlog/README.md); without them the backup still runs and nothing is logged
# (Mac keychain items 'spx-stats TURSO_DATABASE_URL' and 'spx-stats TURSO_RUNLOG_TOKEN'; the token must be able to WRITE)
TURSO_DATABASE_URL=
TURSO_RUNLOG_TOKEN=

# optional
# BACKUP_TIME=05:30            local time of the nightly run in BACKUP_TZ
# BACKUP_TZ=America/Toronto
# BACKUP_MAX_TRIES=3           tries per day when a run fails, BACKUP_RETRY_SECS (3600) apart
# BACKUP_REF=origin/main       or a commit sha to pin the job's code
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# BACKUP_MIN_PERCENT=80        a dump smaller than this percent of the previous one is parked, not accepted
# BACKUP_ACTOR=nas2            who the run log names
