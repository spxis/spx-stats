# Copy to release-runner.env on the NAS (next to docker-compose.yml) and fill in the values. Never commit the real file.
# Names only here; the values are in the private file (Dropbox /Backups/spx-stats/START-HERE.md).

# production: Supabase access token (Management API)
SUPABASE_ACCESS_TOKEN=

# DS1 is on the same NAS; the container uses host networking, so this is the NAS itself
PGHOST=127.0.0.1
PGPORT=55440
PGUSER=postgres
PGDATABASE=spx_stats
PGPASSWORD=

# optional: refresh the changed pages of the site right after a release (one POST per release). Both must be set.
# REVALIDATE_URL=https://spxn.com/api/revalidate
# REVALIDATE_SECRET=              # the same value as the site's REVALIDATE_SECRET (32 or more characters)

# optional
# RELEASE_DAILY_TIMEOUT=2400     # seconds a requested scores update may run
# RELEASE_REF=origin/main        # or a commit sha to pin the runner's code
# DRIFT_HOUR=3                   # UTC hour after which the nightly drift check runs
# RELEASE_MAX_DB_MB=450          # refuse a release that would take production above this

# API watchdog: probes production's REST API once a minute; after 5 failures in a row it reloads PostgREST's schema, after 5 more it
# restarts the project (at most once an hour). See runner/README.md.
# WATCHDOG=0                     # switch it off
# WATCHDOG_RESTART_GAP=3600      # at least this many seconds between two restarts
