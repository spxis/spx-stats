# Copy to release-runner.env on the NAS (next to docker-compose.yml) and fill in the values. Never commit the real file.
# Names only here; the values are in the private file (Dropbox /Backups/spx-stats/START-HERE.md).

# production: Supabase access token (Management API)
SUPABASE_ACCESS_TOKEN=

# DS1 is on the same NAS; the container uses host networking, so this is the NAS itself
PGHOST=127.0.0.1
PGPORT=55440
PGUSER=postgres
PGDATABASE=spx_stats
PGPASSWORD=

# optional
# RELEASE_REF=origin/main        # or a commit sha to pin the runner's code
# DRIFT_HOUR=3                   # UTC hour after which the nightly drift check runs
# RELEASE_MAX_DB_MB=450          # refuse a release that would take production above this
