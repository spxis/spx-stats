# The read-only `api` schema of the SPX archive, over Supabase's REST API (PostgREST).
# Both values are public by design (the key is Supabase's publishable key and can only
# read what the api schema exposes). The defaults below are what the live site uses, so
# the app runs with no .env at all; set them to point at another project.
NEXT_PUBLIC_SUPABASE_URL=https://njpvfrceahkvnrduerkk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FmeiL6oX9_Mrb8psQZFSQg_YO_O4afC
