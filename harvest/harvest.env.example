# Copy to harvest.env on the NAS (next to docker-compose.yml). Never commit the real file.
# Names only here; the DS1 password is in the Mac keychain (item 'spx-stats-db DS1 55440') and the private file. harvest/README.md has the one command that writes it.

# DS1 is on the same NAS; the container uses host networking, so this is the NAS itself
PGHOST=127.0.0.1
PGPORT=55440
PGUSER=postgres
PGDATABASE=spx_stats
PGPASSWORD=

# optional (the defaults are the ones to keep)
# HARVEST_REF=origin/main          # or a commit sha to pin the job's code
# HARVEST_WP_GAP=1.0               # seconds between en.wikipedia.org API requests (1 is the floor: Wikimedia asks for serial requests)
# HARVEST_WD_GAP=1.0               # seconds between wikidata.org API requests
# HARVEST_WDQS_GAP=5.0             # seconds between Wikidata Query Service queries
# HARVEST_MAXLAG=5                 # maxlag sent to en.wikipedia.org
# HARVEST_WD_MAXLAG=60             # maxlag sent to www.wikidata.org (its maxlag counts the SPARQL service's lag, often 20+ s; see README)
# HARVEST_PAUSE_WINDOW=09:50-10:30 # local time (HARVEST_PAUSE_TZ, America/Toronto) when the job stands still for the daily scores run; empty = no window
# HARVEST_CYCLE_SECS=3600          # one worker process runs this long, then the loop fetches the code again
# HARVEST_PLAN_EVERY_HOURS=6       # how often the planner measures the gaps in DS1 and queues new targets
# HARVEST_RECENT_REFRESH_DAYS=2    # re-read a page of the current season this often (only its revision id is asked for)
# HARVEST_OLD_REFRESH_DAYS=120     # re-read an older page this often
# HARVEST_UA=                      # leave unset: spx-stats-harvest/1.0 (https://spxn.com; archive of sports history, non-commercial)
