# The PostgREST settings on DS1 that every local copy uses (no secrets). Read by scripts/mac/lib/ds1-pgrst.sh (docker run --env-file) and by
# scripts/mac/ds1-preview/docker-compose.yml (env_file), so the one-off and the always-on PostgREST cannot drift. No quotes: both parsers take the value as written.
# PGOPTIONS makes every session read-only with a statement limit (a ?options= in the connection URI is ignored by PostgREST; libpq's variable works).
PGOPTIONS=-c default_transaction_read_only=on -c statement_timeout=120000
PGRST_DB_SCHEMAS=api
PGRST_DB_ANON_ROLE=anon
PGRST_DB_MAX_ROWS=1000
PGRST_DB_POOL=8
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_CONFIG=false
PGRST_DB_CHANNEL_ENABLED=false
PGRST_SERVER_HOST=0.0.0.0
PGRST_LOG_LEVEL=error
