{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spx-stats hand-off",
  "description": "One file per ticket at Dropbox /Projects/Handoff/<project>/<ticket-id>.json. No secrets, no private host names or addresses. Never committed (examples/ is the exception).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "ticket_id", "title", "status", "written_by", "written_at", "kind", "site_only", "commits"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "ticket_id": {"type": "string", "pattern": "^[a-z0-9]{20,40}$"},
    "title": {"type": "string", "minLength": 8, "maxLength": 200},
    "status": {"type": "string", "enum": ["ready", "data-applied-not-released", "blocked", "needs-decision", "deployed", "released", "failed", "needs-change"]},
    "written_by": {"type": "string", "minLength": 2, "maxLength": 80},
    "written_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9:.]+Z?)?$"},
    "kind": {"type": "string", "enum": ["site", "data", "package", "tooling"]},
    "site_only": {"type": "boolean"},
    "commits": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}},
    "migrations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["file", "objects"],
        "properties": {
          "file": {"type": "string", "pattern": "^db/[A-Za-z0-9_./-]+\\.sql$"},
          "objects": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^((table|function|column):)?[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)+(\\([a-z0-9_, ]*\\))?$"}}
        }
      }
    },
    "turso_tables": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$"}},
    "ds1_steps": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["file", "expect"],
        "properties": {
          "file": {"type": "string", "pattern": "^db/[A-Za-z0-9_./-]+\\.sql$"},
          "expect": {"type": "string", "minLength": 3, "maxLength": 400}
        }
      }
    },
    "release_tables": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*\\.[a-z_][a-z0-9_]*$"}},
    "release_title": {"type": "string", "minLength": 3, "maxLength": 200},
    "release": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]+$"},
    "deploy_after_release": {"type": "boolean"},
    "pages": {"type": "array", "items": {"type": "string", "pattern": "^/[A-Za-z0-9/_.?=&%-]*$"}},
    "package": {
      "type": "object", "additionalProperties": false, "required": ["name", "dir", "tag"],
      "properties": {
        "name": {"type": "string", "minLength": 2, "maxLength": 80},
        "dir": {"type": "string", "pattern": "^~/[A-Za-z0-9_./-]+$"},
        "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
      }
    },
    "notes_for_john": {"type": "string", "maxLength": 2000},
    "blocked_reason": {"type": "string", "maxLength": 1000},
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["question", "options", "recommendation"],
      "properties": {
        "question": {"type": "string", "minLength": 5, "maxLength": 400},
        "options": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "label"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9]{1,4}$"},
              "label": {"type": "string", "minLength": 3, "maxLength": 300},
              "note": {"type": "string", "maxLength": 600}
            }
          }
        },
        "recommendation": {"type": "string", "pattern": "^[A-Za-z0-9]{1,4}$"}
      }
    }
  }
}
