{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spx-stats coordination roles",
  "description": "Dropbox /Projects/Handoff/<project>/ROLES.json. Who holds which role. Changed only through `coord.py handover` (or `roles init` once), only when John says so. No secrets, no private host names or addresses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "updated", "roles"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release-master", "builder", "outside-builder", "reviewer"],
      "properties": {
        "release-master": {"type": "object", "additionalProperties": false, "required": ["holders", "since", "handover"], "properties": {"holders": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"}}, "since": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9:.]+Z?)?$"}, "handover": {"type": "string", "maxLength": 400}}},
        "builder": {"type": "object", "additionalProperties": false, "required": ["holders", "since", "handover"], "properties": {"holders": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"}}, "since": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9:.]+Z?)?$"}, "handover": {"type": "string", "maxLength": 400}}},
        "outside-builder": {"type": "object", "additionalProperties": false, "required": ["holders", "since", "handover"], "properties": {"holders": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"}}, "since": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9:.]+Z?)?$"}, "handover": {"type": "string", "maxLength": 400}}},
        "reviewer": {"type": "object", "additionalProperties": false, "required": ["holders", "since", "handover"], "properties": {"holders": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"}}, "since": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9:.]+Z?)?$"}, "handover": {"type": "string", "maxLength": 400}}}
      }
    }
  }
}
