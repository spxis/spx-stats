{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spx-stats hand-off replies",
  "description": "Dropbox /Projects/Handoff/<project>/replies/<ticket-id>.json. Append-only: entries are only ever added to history. Handled files move to replies/read/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "ticket_id", "history"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "ticket_id": {"type": "string", "pattern": "^[a-z0-9]{20,40}$"},
    "history": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["at", "from", "status", "detail"],
        "properties": {
          "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"},
          "from": {"type": "string", "minLength": 2, "maxLength": 80},
          "status": {"type": "string", "enum": ["deployed", "data-applied", "released", "failed", "needs-change", "blocked"]},
          "version": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
          "deployment": {"type": "string", "maxLength": 200},
          "release": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-[0-9]+$"},
          "checked": {"type": "array", "items": {"type": "string", "maxLength": 300}},
          "detail": {"type": "string", "minLength": 3, "maxLength": 2000},
          "change_requested": {"type": "string", "maxLength": 2000}
        }
      }
    }
  }
}
