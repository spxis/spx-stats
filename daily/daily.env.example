# Copy to daily.env on the NAS (next to docker-compose.yml) and fill in the value. Never commit the real file.
# Names only here; the value is in the Mac keychain (item 'spx-stats-db DS1 55440') and the private file (Dropbox /Backups/spx-stats/START-HERE.md).

# DS1 is on the same NAS; the container uses host networking, so this is the NAS itself
PGHOST=127.0.0.1
PGPORT=55440
PGUSER=postgres
PGDATABASE=spx_stats
PGPASSWORD=

# optional
# DAILY_REF=origin/main          # or a commit sha to pin the job's code
# DAILY_TIME=10:00               # local time of the daily run in DAILY_TZ
# DAILY_TZ=America/Toronto
# DAILY_MAX_TRIES=3              # tries per day when a run fails, DAILY_RETRY_SECS (3600) apart
# SPX_WIKI_UA=                   # leave unset: the default is spx-stats/1.0 (https://spxn.com; john@spxis.com)

# optional, OFF by default: prepare a data release after a run that changed something (scripts/daily/release_hook.py).
# Needs the production access token, which can do anything in the Supabase project: leave DAILY_PREPARE_RELEASE and the token unset to
# let the nightly drift check on the release runner propose the change instead.
# DAILY_PREPARE_RELEASE=1        # switch the hook on (needs SUPABASE_ACCESS_TOKEN, and the DS1 PG settings above)
# SUPABASE_ACCESS_TOKEN=
# DAILY_RELEASE_KIND=daily_scores   # scores-only runs (core.game, meta.verification, meta.data_issue) become an auto-approved daily_scores
#                                   # release; a run that also touched a season, team season or external id becomes a normal release
#                                   # titled "(needs review)" that waits for John. Unset: every run takes the review route.
